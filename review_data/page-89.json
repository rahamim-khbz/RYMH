      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b93d1124",
      "kind": "main",
      "idx": 21,
      "text": "ועיין תשב\"ן ח\"ג סימן יו\"ד וסי' רנ\"ח",
