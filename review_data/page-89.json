      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_e1717fdb",
      "kind": "main",
      "idx": 32,
      "text": "קדמונים לבד, שמוסיף בסוף התשו' אחר אסרוחי מסרח, ואסור לשתות ממנו בימי",
      "coords": {
        "HPOS": 310,
