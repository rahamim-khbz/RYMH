        "HPOS": 1141,
        "VPOS": 421,
        "WIDTH": 352,
        "HEIGHT": 105
      },
      "para_start": true,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_4e3c16a8",
      "kind": "main",
