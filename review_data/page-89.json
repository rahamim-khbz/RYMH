      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_a3a3028b",
      "kind": "main",
      "idx": 31,
      "text": "תשובה זאת כדמותה מובאה בפרדס די\"ז ע\"א בלי שם וכנוי, אבל נראה שם אסיפת תשובת",
      "coords": {
        "HPOS": 304,
        "VPOS": 2150,
        "WIDTH": 2025,
        "HEIGHT": 77
