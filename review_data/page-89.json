        "WIDTH": 1781,
        "HEIGHT": 66
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_070162e8",
      "kind": "main",
      "idx": 27,
      "text": "והרבש ואמרינן (ע\"ז רף ט\"ל ע\"ב) האי דבש למאי ליחוש ליה משום בישורי גוים נאכל כמו",
      "coords": {
