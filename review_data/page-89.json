        "HEIGHT": 105
      },
      "para_start": true,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_ec83ba4d",
      "kind": "main",
      "idx": 5,
      "text": "'חמאה של גוים אסור או מותר ביון דקים להו לרבנן דחלב טהור עומר טמא",
      "coords": {
