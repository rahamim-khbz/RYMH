      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_372fa9d2",
      "kind": "main",
      "idx": 6,
      "text": "אינו עומד מותר אלא שאין הדעת מקבלת ומי שיפה דעתו ואכל מותר",
      "coords": {
        "HPOS": 443,
