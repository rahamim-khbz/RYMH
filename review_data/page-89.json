      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2817bd71",
      "kind": "main",
      "idx": 28,
      "text": "שהוא חי הוא ואי משום גיעורי גוים נותן טעם לפגם הוא ואי משום דמערבי ביה אסרוחי מסרח",
      "coords": {
        "HPOS": 304,
        "VPOS": 1912,
        "WIDTH": 2014,
        "HEIGHT": 66
