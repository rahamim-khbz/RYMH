      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b4d83597",
      "kind": "main",
      "idx": 25,
      "text": "בלא מחלוקת וכו' וכו', אבל כשהגיע הזמן לאנשי כנ\"הג הכירו בהתחלת חסרונם והיו כותבים",
      "coords": {
        "HPOS": 328,
        "VPOS": 1837,
        "WIDTH": 1981,
        "HEIGHT": 82
