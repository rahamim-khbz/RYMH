      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_1ec32f0a",
      "kind": "main",
      "idx": 30,
      "text": "נודע זה הסיפור אלא מדרך שנמצא כתוב בן שהרי ר' דוסא זה היה",
