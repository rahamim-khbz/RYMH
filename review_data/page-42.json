      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_40a1138b",
      "kind": "main",
      "idx": 14,
      "text": "ומה שהיה מתחדש ויצטרכו בו להתבוננות לפי חדוש הענינים נמסרו להם העיקרים והמדות שמהם",
      "coords": {
        "HPOS": 333,
        "VPOS": 1158,
        "WIDTH": 1982,
        "HEIGHT": 63
