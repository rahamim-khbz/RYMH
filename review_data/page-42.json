      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_05807439",
      "kind": "main",
      "idx": 23,
      "text": "נדרשת בהם שולטת בו, ולפעמים ג\"כ היו סומכין קבלותיהם במקראות דרך אסמכתא בעלמא, והכל",
      "coords": {
        "HPOS": 330,
        "VPOS": 1717,
        "WIDTH": 1981,
        "HEIGHT": 68
