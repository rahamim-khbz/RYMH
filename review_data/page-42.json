      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_5ca8627f",
      "kind": "main",
      "idx": 15,
      "text": "היו מוצאים תעלומותיהם לאור ומבררים כל הדינים, ומה שלא יספק בהם ההקש והסברא, לפעמים",
      "coords": {
        "HPOS": 332,
        "VPOS": 1213,
        "WIDTH": 1977,
        "HEIGHT": 64
