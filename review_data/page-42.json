    {
      "line_id": "eSc_line_10044f54",
      "kind": "main",
      "idx": 11,
      "text": "פסקי הצריכים לעינינו וז\"ל: \"ודע שכל הזמנים שהוזכרו עד סוף זמן הנביאים, והוא זמן חרבן בית",
      "coords": {
        "HPOS": 332,
        "VPOS": 962,
        "WIDTH": 1981,
        "HEIGHT": 68
