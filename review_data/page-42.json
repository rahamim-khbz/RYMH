      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_cefdecc0",
      "kind": "main",
      "idx": 16,
      "text": "היו הולכים בו אחר הרוב, כאומרו אחרי רבים להטות, ולפעמים היתה הנבואה מבררת להם כל",
      "coords": {
        "HPOS": 330,
        "VPOS": 1276,
        "WIDTH": 1979,
        "HEIGHT": 66
