      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d6a67b18",
      "kind": "main",
      "idx": 26,
      "text": "כל אחד לעצמו מה ששמע מרבו אם ראשוני החכמים במה ששמעו מאחרוני",
      "coords": {
        "HPOS": 332,
        "VPOS": 1910,
        "WIDTH": 1968,
        "HEIGHT": 77
