    {
      "line_id": "eSc_line_c21c15d9",
      "kind": "main",
      "idx": 40,
      "text": "דעת רש\"י ז\"ל בשום אופן שבעולם כאשר האריך הרחיב בכל אורך הסימן הזה ובכח זה בדינא ובדייני",
      "coords": {
        "HPOS": 284,
        "VPOS": 2671,
        "WIDTH": 2033,
        "HEIGHT": 75
