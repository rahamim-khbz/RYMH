      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_8d8a688a",
      "kind": "main",
      "idx": 8,
      "text": "חדש שלא נמצא בתלמוד להפך, ואין מביאין ראיה לדבריהם הא ודאי עלייהו סמכינן מבלי שום ריח",
      "coords": {
        "HPOS": 277,
        "VPOS": 713,
        "WIDTH": 2045,
        "HEIGHT": 80
