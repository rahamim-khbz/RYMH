      "line_id": "eSc_line_bbb9a8a5",
      "kind": "main",
      "idx": 35,
      "text": "ערומה כיום הולדה ולא לכסית אותה בשמיכת ההכרעה לפי הדור? והלא עדין לחלוחית הדיו קיימת",
      "coords": {
        "HPOS": 280,
        "VPOS": 2346,
        "WIDTH": 2038,
        "HEIGHT": 66
