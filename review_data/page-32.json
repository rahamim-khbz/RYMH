    {
      "line_id": "eSc_line_2850da32",
      "kind": "main",
      "idx": 34,
      "text": "נתן אחר האחרון ובן א\"י היה, ולא ר' יהונתן שמו, ועל ר' נתן האחרון הלזה הוא שאמרו רבי ורבי נתן סוף משנה, וע\"ז",
      "coords": {
        "HPOS": 243,
        "VPOS": 2117,
        "WIDTH": 2029,
        "HEIGHT": 79
