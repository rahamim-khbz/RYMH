      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_0adf21fe",
      "kind": "main",
      "idx": 31,
      "text": "כשירדתי לנהרדעה וכו' אחר רבי חנינא בן אחי ר' יהושע לגולה וכו' מאי",
      "coords": {
        "HPOS": 227,
        "VPOS": 2172,
        "WIDTH": 2003,
        "HEIGHT": 81
