      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_3b8879cc",
      "kind": "main",
      "idx": 30,
      "text": "רהוו קמיה\" שר\"ל שהיו קודמים לו כמו שמביא ראיות ע\"ז ודוק) הוו להו מתניתא וכו\"",
      "coords": {
        "HPOS": 231,
        "VPOS": 2110,
        "WIDTH": 1986,
        "HEIGHT": 80
