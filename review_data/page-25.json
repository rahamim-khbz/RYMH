      "text": "קבעינהו למגרסינהו כ\"ע כדאקבעון ברייתא דר\"ח ור\"א ולא אמרי' מנייהו",
      "coords": {
        "HPOS": 238,
        "VPOS": 2817,
        "WIDTH": 1994,
        "HEIGHT": 81
      },
      "para_start": false,
      "is_catchword": false
    },
    {
