      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d5aefedc",
      "kind": "main",
      "idx": 10,
      "text": "ודברנו בה ככל הצורך לא נאריך בה הדבור, ויספיק לנו בהזכיר את הקורא מה שכתבנו",
      "coords": {
        "HPOS": 311,
        "VPOS": 843,
        "WIDTH": 1747,
        "HEIGHT": 68
