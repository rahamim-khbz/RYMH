      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_006bf38a",
      "kind": "main",
      "idx": 24,
      "text": "אמרו במדרש קהלת, ויותר מהמה בני הזהר, כל המכניס בתוך ביתו יותר מכ\"ד ספרים מהומה הוא",
      "coords": {
        "HPOS": 310,
        "VPOS": 1607,
        "WIDTH": 1990,
        "HEIGHT": 68
