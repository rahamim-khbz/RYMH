    {
      "line_id": "eSc_line_6f611dc0",
      "kind": "main",
      "idx": 23,
      "text": "שהגירסא הנזכרת בתלמוד אינה אלא בע\"פ לפי שכל עניני תורה שבע\"פ לא היו אז אלא בע\"פ, ולפיכך",
      "coords": {
        "HPOS": 313,
        "VPOS": 1540,
        "WIDTH": 1987,
        "HEIGHT": 71
