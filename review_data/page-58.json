      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_a0b33499",
      "kind": "main",
      "idx": 20,
      "text": "באנו",
      "coords": {
        "HPOS": 2124,
        "VPOS": 1409,
        "WIDTH": 174,
        "HEIGHT": 81
