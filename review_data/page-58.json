        "WIDTH": 1982,
        "HEIGHT": 54
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d222dc13",
      "kind": "main",
      "idx": 2,
      "text": "(ישראל בבירור חקירה זאת ממזרח וממערב, שהגאונים חיד\"א ויר\"ח (הוא מר זקני יוסף רפאל חזן ז\"ל",
      "coords": {
        "HPOS": 308,
        "VPOS": 390,
        "WIDTH": 1985,
        "HEIGHT": 73
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_dd307a37",
      "kind": "main",
      "idx": 3,
      "text": "העירו ממזרח ועמדו על מבוכה זאת, ואחרי דרך מבוא השמש פלפלו בזה כמבואר בכרם, ודאתי",
      "coords": {
        "HPOS": 313,
        "VPOS": 471,
        "WIDTH": 1982,
        "HEIGHT": 53
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_6d6c4e4a",
      "kind": "main",
      "idx": 4,
      "text": ",מחמתיה, ובאתי אני אחרון לכל בית יוסף, והקרבתי שני הקצוות יחד, א\"כ נאמר אל דורינו זה",
      "coords": {
        "HPOS": 317,
        "VPOS": 520,
        "WIDTH": 1978,
        "HEIGHT": 81
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_9f93a887",
      "kind": "main",
      "idx": 5,
      "text": "התחלת במצוה? זיל גמור, ונפלפל בזה עוד עד מקום שיד שכלנו מגעת באהבת האמת, וניתן גמר",
      "coords": {
        "HPOS": 313,
        "VPOS": 595,
        "WIDTH": 1982,
        "HEIGHT": 57
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d6ecd4d6",
      "kind": "main",
      "idx": 6,
      "text": "טוב על מבוכה זאת עפ\"י רוב מנין ורוב בנין, ונניח להבאים אחרינו דרך כבושה לרבים בענין אדיר כזה",
      "coords": {
        "HPOS": 311,
        "VPOS": 661,
        "WIDTH": 1984,
        "HEIGHT": 55
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_4e3ddaf9",
      "kind": "main",
      "idx": 7,
      "text": ".שחיי סיפור קורות תושבע\"פ תלויה בו",
      "coords": {
        "HPOS": 922,
        "VPOS": 727,
        "WIDTH": 784,
        "HEIGHT": 61
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_72fee5dd",
      "kind": "main",
      "idx": 8,
      "text": "ואבא",
      "coords": {
        "HPOS": 2093,
        "VPOS": 775,
        "WIDTH": 205,
        "HEIGHT": 84
      },
      "para_start": true,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_c7fe8125",
      "kind": "main",
      "idx": 9,
      "text": ",בדרך ישר להתטפל ולהשיב על ראיותיו אחת אל אחת, ועל ראיה שכבר עברנו עליה",
      "coords": {
        "HPOS": 321,
        "VPOS": 777,
        "WIDTH": 1744,
        "HEIGHT": 71
