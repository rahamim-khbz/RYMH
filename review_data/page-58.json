      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d1c19fa8",
      "kind": "main",
      "idx": 25,
      "text": "מכניס בביתו, מה שלא היו אומרים אם היה שהיתה להם המשנה כתובה על ספר, ואמרו כגון ספר",
      "coords": {
        "HPOS": 315,
        "VPOS": 1668,
        "WIDTH": 1985,
        "HEIGHT": 70
