    },
    {
      "line_id": "_9ee6881e-8706-41e1-b8cb-52a37fc3abe9",
      "kind": "main",
      "idx": 40,
      "text": "לפי דעתם דעת עליון. מעתה חובה עלינו לשים משטר קולמוסנו לברר דבריהם אחד אל אחד שלא",
      "coords": {
        "HPOS": 286,
        "VPOS": 2751,
        "WIDTH": 2025,
        "HEIGHT": 57
