    {
      "line_id": "eSc_line_5d3430a8",
      "kind": "main",
      "idx": 21,
      "text": ".ן' כ\"ט, נד\"ו יש תשו' לרבינו שרירא הגאון ז\"ל וזה נוסחה אות באות",
      "coords": {
        "HPOS": 1060,
