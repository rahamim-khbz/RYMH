        "HEIGHT": 86
      },
      "para_start": true,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_1e0ddc5e",
      "kind": "main",
      "idx": 1,
      "text": "הלזה אלא כמעיד שהכתיבה היתה אסודה, וכיון דמפני ההכרח פרץ גדר מי שכתבה ע\"כ הסתירה",
      "coords": {
        "HPOS": 256,
