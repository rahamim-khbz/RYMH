      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2edd8352",
      "kind": "main",
      "idx": 29,
      "text": "ונשוב לענינינו, והוא שאחר שריה\"ק חיבר המשנה, ור\"ח הברייתא, נמשכו אחריו קצת חכמים, וחבר",
      "coords": {
        "HPOS": 315,
        "VPOS": 2091,
        "WIDTH": 1992,
        "HEIGHT": 68
