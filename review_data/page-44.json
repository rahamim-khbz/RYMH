      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_e1b60e1c",
      "kind": "main",
      "idx": 30,
      "text": "רב חבור בס' ויקרא וקראו ספרא וכו' וכו' וגילה בהם מצפוני המשניות שבאותם הענינים ואז ירד רב",
      "coords": {
        "HPOS": 310,
        "VPOS": 2165,
        "WIDTH": 1996,
        "HEIGHT": 58
