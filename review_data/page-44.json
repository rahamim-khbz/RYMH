      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_e391db6f",
      "kind": "main",
      "idx": 22,
      "text": "כל אחד מהם כותבם כמו שהיה מקובל מרבו, או ממה שהיה למד הוא מעצמו, ומתוך",
      "coords": {
        "HPOS": 315,
        "VPOS": 1651,
        "WIDTH": 1985,
        "HEIGHT": 76
