      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_ee2c44ed",
      "kind": "main",
      "idx": 14,
      "text": "בטבע קיים, שהרי כשהנחילה לנו האל יתעלה הראה לדעת כי רצונו, בקיומה נצח, ולא תשכח מפי",
      "coords": {
        "HPOS": 218,
        "VPOS": 1114,
        "WIDTH": 2025,
        "HEIGHT": 68
