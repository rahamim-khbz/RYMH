    {
      "line_id": "eSc_line_66346b44",
      "kind": "main",
      "idx": 11,
      "text": "ואחרי הודיע אלהים אותנו את כל זאת, עד שחזר דבר ברור וצלול כשמש בתקופת תמוז נאמר",
      "coords": {
        "HPOS": 221,
        "VPOS": 922,
