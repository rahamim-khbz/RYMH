    {
      "line_id": "eSc_line_82e858e9",
      "kind": "main",
      "idx": 31,
      "text": "כחומר ביד היוצר, כי אל כל אשר יחפוץ יטנו, ולא בדרך הפלגה, הייטב בעיני ה' שניסר יסוד אמונתנו",
      "coords": {
        "HPOS": 223,
        "VPOS": 2212,
        "WIDTH": 2018,
        "HEIGHT": 83
      },
      "para_start": false,
      "is_catchword": false
