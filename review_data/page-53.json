      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_f5a686ac",
      "kind": "main",
      "idx": 18,
      "text": "שיוכל להכחיש, כי הדורות נוחים לשכוח כשיוכפלו צרותיה\"ן וצרו\"ת צרותיה\"ן, וכאשר ראינו בשמואל",
      "coords": {
        "HPOS": 218,
        "VPOS": 1371,
        "WIDTH": 2025,
        "HEIGHT": 79
