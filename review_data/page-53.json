      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_907b955f",
      "kind": "main",
      "idx": 10,
      "text": ".אחים ולא יתפרדו, וכחדא נפקין וכחדא שריין ולא מתפרשין לעלמין",
