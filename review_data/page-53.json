    {
      "line_id": "eSc_line_069d8528",
      "kind": "main",
      "idx": 24,
      "text": "בשתי פרשיות, בחוקותי וכי תבא, השורפות כליות ולב, א\"כ הרי היא ממש מתנבאת בקולי",
