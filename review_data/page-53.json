      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_652f531a",
      "kind": "main",
      "idx": 17,
      "text": "טבעית בחומר האדם, ואפי' יושב תחת גפנו ותחת תאנתו, ודבר אין לו שיעיקהו, עוד זאת אין מי",
      "coords": {
        "HPOS": 220,
        "VPOS": 1309,
        "WIDTH": 2019,
        "HEIGHT": 77
