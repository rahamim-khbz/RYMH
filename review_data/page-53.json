      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_3cd18b9b",
      "kind": "main",
      "idx": 8,
      "text": "עמלק, הוא מנהג קדמון באומה מאז היתה לגוי, ועיקרו מיוסד כדי לקיים, ואל תשכח בלב, כי הא",
      "coords": {
        "HPOS": 220,
        "VPOS": 726,
        "WIDTH": 2021,
        "HEIGHT": 80
