    {
      "line_id": "eSc_line_af61d10a",
      "kind": "main",
      "idx": 25,
      "text": "מרבנן ידעי להו בקבלה, ולא הוו צריכי לחבורינהו ולמכתב בינייהו (אפשר",
      "coords": {
        "HPOS": 291,
        "VPOS": 1565,
        "WIDTH": 2029,
        "HEIGHT": 88
