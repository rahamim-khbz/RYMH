      "line_id": "eSc_line_dfc43997",
      "kind": "main",
      "idx": 21,
      "text": "עליו השואל ספקו האדיר, המחולק לד' סעיפיו וע\"ז מסיים ואומר: \"על' הדין אורחא",
      "coords": {
        "HPOS": 291,
        "VPOS": 1373,
        "WIDTH": 2031,
        "HEIGHT": 79
