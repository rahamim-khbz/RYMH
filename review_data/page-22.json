      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_93cc115b",
      "kind": "main",
      "idx": 24,
      "text": "קמאי לא הוו צדיכי לחיבורים, ומילי דמגרסן ע\"פ אינון וכל חד וחד",
      "coords": {
        "HPOS": 295,
