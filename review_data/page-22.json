      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d01d250c",
      "kind": "main",
      "idx": 15,
      "text": ",דא פליג בהון\" עד כאן היה גאוננו הולך ומתיד כל חד מד' סעיפי הס' הא' כל אחד לעצמו",
