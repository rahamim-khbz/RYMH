    {
      "line_id": "eSc_line_365e77e0",
      "kind": "main",
      "idx": 13,
      "text": "או בלישני\" רויחי (ח\"מ וכ\"י וויין ויוחסין \"צויחי\" טס\"ן) אבל סמכא דישראל על",
      "coords": {
        "HPOS": 293,
        "VPOS": 852,
