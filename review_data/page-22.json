      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_029e7905",
      "kind": "main",
      "idx": 27,
      "text": "צריכין לחבורי, דהא ר\"א בן הורקנוס וכו', אלא שלא אמר דבר שלא שמע",
      "coords": {
        "HPOS": 288,
        "VPOS": 1697,
        "WIDTH": 2032,
        "HEIGHT": 79
