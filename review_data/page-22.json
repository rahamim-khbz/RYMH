      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_ca138d0a",
      "kind": "main",
      "idx": 17,
      "text": "משנה ר\"מ בטוב טעם ודעת, והראה גם כן למה רוב החכמים המוזכרים הם תלמידי ר\"ע, והראה",
      "coords": {
        "HPOS": 289,
        "VPOS": 1123,
        "WIDTH": 2033,
        "HEIGHT": 72
