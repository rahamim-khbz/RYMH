      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2dfb6dbb",
      "kind": "main",
      "idx": 26,
      "text": "צ\"ל דיניהו) עד דחריב ב\"המ\" וקמו תלמידיהון ולא ידעי כוותהון והוו",
      "coords": {
        "HPOS": 302,
