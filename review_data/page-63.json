    {
      "line_id": "eSc_line_37917ecc",
      "kind": "main",
      "idx": 0,
      "text": "תתבאר בשופי מתוך הכתב \"לאומרם בכתב\" כלומר והכתב בידו ובהכרח לומד מתוכו, ובפרט כי יד",
      "coords": {
        "HPOS": 243,
