      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_5fd0c959",
      "kind": "main",
      "idx": 24,
      "text": "בפ' כל כתבי וז\"ל: \"וכבר התיר רבי לכתוב תושבע\"פ משום עת לעשות לה'\" זה באמת תורה חדשה",
      "coords": {
        "HPOS": 242,
        "VPOS": 1769,
        "WIDTH": 2014,
        "HEIGHT": 73
