      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_4b6a3914",
      "kind": "main",
      "idx": 20,
      "text": "ומה שאנו עתידין לבאר לקמן בביאור דברי ר' יוחנן אלו, עכ\"פ קשה, מהיכן ראה שהותרו משום עת",
      "coords": {
        "HPOS": 243,
        "VPOS": 1514,
        "WIDTH": 2018,
        "HEIGHT": 66
