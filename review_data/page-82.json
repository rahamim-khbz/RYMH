        "WIDTH": 523,
        "HEIGHT": 69
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_7f1f07a3",
      "kind": "main",
      "idx": 39,
      "text": "אמת שעל קודם דבינו הקדוש ז\"ל לא נזכרה בהקדמת ר\"ן ז\"ל שום ענין, באשו באחת לא נזכרה גם באגרת רש\"ג ז\"ל",
      "coords": {
