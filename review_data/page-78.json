      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_652f7038",
      "kind": "main",
      "idx": 20,
      "text": "אשר הם טבעיים לתושבע\"פ, והנה האופן הראשון הוא שאמרנו בשמועה דיבמות די\"ו שכשנמצא",
      "coords": {
        "HPOS": 354,
