    {
      "line_id": "eSc_line_dcd2d60c",
      "kind": "main",
      "idx": 23,
      "text": "עדיין היה האיסור בתקפו ובגבורתו ובפרט בפי ר\"ד בן הרכינס שהיה מהקדמונים מזמן הלל ושמאי",
      "coords": {
        "HPOS": 359,
        "VPOS": 1780,
        "WIDTH": 1963,
        "HEIGHT": 51
