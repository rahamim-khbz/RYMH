        "HPOS": 355,
        "VPOS": 2018,
        "WIDTH": 1973,
        "HEIGHT": 70
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b5e5d61d",
      "kind": "main",
      "idx": 28,
      "text": "שעל מדוכה\" דלשון מקובל אני יפול על דבר הנשמע מפה לאזן כמו שהוא מורגל בכל התלמוד, ובפרט",
      "coords": {
        "HPOS": 355,
        "VPOS": 2084,
        "WIDTH": 1973,
        "HEIGHT": 66
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2c945c43",
      "kind": "main",
      "idx": 29,
      "text": "בסוף עדויות ודוק היטב, שלפירוש רבינו שרירא ז\"ל בתשו' כ\"י הנז\"ל, אינו מתיישב כלל, ורוק במ\"ש",
      "coords": {
        "HPOS": 354,
        "VPOS": 2146,
        "WIDTH": 1972,
        "HEIGHT": 66
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_efa354fb",
      "kind": "main",
      "idx": 30,
      "text": "לעיל הערה (כ\"ח). והאופן השני הוא שהתחיל רב להשתמש ממנו שכבר ירדו הדורות וככר נתפרסם",
      "coords": {
        "HPOS": 355,
        "VPOS": 2216,
        "WIDTH": 1974,
        "HEIGHT": 68
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_ebfb5685",
      "kind": "main",
      "idx": 31,
      "text": "הרבה שהיתה כל תורה שבע\"פ כתובה וגנוזה, ורב עצמו הביא לבבל מהדורא בתרא של המשניות",
      "coords": {
        "HPOS": 354,
        "VPOS": 2277,
        "WIDTH": 1974,
        "HEIGHT": 60
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b3a9cc43",
      "kind": "main",
      "idx": 32,
      "text": "מ\"א) וע\"ז הרהיב בנפשו עז ואמר \"מצאתי מגילת סתרים וכתוב בה כך וכך, וכיון שלא היה יכול",
      "coords": {
        "HPOS": 359,
        "VPOS": 2339,
        "WIDTH": 1956,
        "HEIGHT": 73
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_e766730a",
      "kind": "main",
      "idx": 33,
      "text": "לומר",
      "coords": {
        "HPOS": 493,
        "VPOS": 2401,
        "WIDTH": 106,
        "HEIGHT": 63
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_7ebd995a",
      "kind": "main",
      "idx": 34,
      "text": "א",
      "coords": {
        "HPOS": 2271,
        "VPOS": 2530,
        "WIDTH": 49,
        "HEIGHT": 60
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2a686036",
      "kind": "main",
      "idx": 35,
      "text": "נדרים דכ\"ז ע\"ב, ועיין מה שפי' שם הר\"ן ופי' נאות לדעת גאוני צרפת דלא היתה כתיבה בעולם, ולדעת גאוני בבל",
      "coords": {
        "HPOS": 357,
        "VPOS": 2522,
        "WIDTH": 1895,
        "HEIGHT": 59
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_dd0c1ff6",
      "kind": "main",
      "idx": 36,
      "text": "וספרד שאנו בהם אין הלשונות והרעיונים הללו יוצאים מידי פשטותם, ואדרכה הם ראיה למדקדק היטב, כי המשל",
      "coords": {
        "HPOS": 359,
        "VPOS": 2577,
        "WIDTH": 1897,
        "HEIGHT": 57
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_22aa7742",
      "kind": "main",
      "idx": 37,
      "text": "הזא יותר מצוי ונגלה ומפורסם מהנמשל, ודוק היטב ותראה כי אם תושבע\"פ לא היתה באפשרות ללוקחה ביד ע\"י הכתיבה",
      "coords": {
        "HPOS": 359,
        "VPOS": 2625,
        "WIDTH": 1967,
        "HEIGHT": 60
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_0d33487d",
      "kind": "main",
      "idx": 38,
      "text": ".בשום אופן שבעולם, מציצת \"העלה בידו\" לא תעלה על לב מלין לעולם אפילו היותר משורר שבעולם",
      "coords": {
        "HPOS": 513,
        "VPOS": 2676,
        "WIDTH": 1679,
        "HEIGHT": 61
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_4b91c714",
      "kind": "main",
      "idx": 39,
      "text": "מ) מאד הייתי חפץ להעתיק לפניך קורא נעיםז מה שהתעלסו בזה החכמים והסוחר המקובל בחיבורי נצח ישראל",
      "coords": {
        "HPOS": 366,
        "VPOS": 2729,
        "WIDTH": 1958,
        "HEIGHT": 63
