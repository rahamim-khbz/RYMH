    {
      "line_id": "eSc_line_75be958b",
      "kind": "main",
      "idx": 23,
      "text": "לאלין ברייתא וכו', ושבחו רבנן למאי דגמיר טובא, ומגליין ליה טעמי",
      "coords": {
        "HPOS": 286,
        "VPOS": 1694,
        "WIDTH": 2020,
        "HEIGHT": 75
