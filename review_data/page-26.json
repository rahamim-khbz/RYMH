    {
      "line_id": "eSc_line_fdab0ce7",
      "kind": "main",
      "idx": 22,
      "text": "חסר) הוה אית להו קץ וכו' ורבנן אמוראי דבתר רבי הוו צריכין טובא",
      "coords": {
        "HPOS": 282,
