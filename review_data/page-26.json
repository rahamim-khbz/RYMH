      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_9c96a091",
      "kind": "main",
      "idx": 26,
      "text": "עבדינן כההוא דתניא מתניתא כותיה כדאמרי' וכו' דהכל",
      "coords": {
        "HPOS": 506,
        "VPOS": 1888,
        "WIDTH": 1796,
        "HEIGHT": 64
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_8d3c94b6",
      "kind": "main",
      "idx": 27,
