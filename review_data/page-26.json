      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_d0407e0c",
      "kind": "main",
      "idx": 17,
      "text": "אין בה נחת כל עיקר, וע\"כ הוו צריכין רבנן לפלפולא וסברא, שהמשנה אינה אלא גזרות בלי טעם",
      "coords": {
        "HPOS": 280,
        "VPOS": 1299,
        "WIDTH": 2024,
        "HEIGHT": 72
