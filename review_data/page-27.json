      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_c90265d5",
      "kind": "main",
      "idx": 22,
      "text": "וכדאמרי' בעירובין וכו' וכן נמי הוה אית להון אנפי אחריתי מתלמודהון",
      "coords": {
        "HPOS": 203,
        "VPOS": 1657,
        "WIDTH": 1987,
        "HEIGHT": 71
