    {
      "line_id": "eSc_line_174891f7",
      "kind": "main",
      "idx": 0,
      "text": "דרך ארץ והגדות אחרות\" כלל הדברים שעיקר הברייתות הם אותם דמתנינן בי ר' חייא",
      "coords": {
        "HPOS": 188,
