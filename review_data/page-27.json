        "HEIGHT": 74
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_ecbea496",
      "kind": "main",
      "idx": 4,
      "text": "הברייתות הן הן תורתן של ראשונים באורך וברוחב כל חד וחד לפום אורחיה וחיליה ולישניה הוה מתני",
      "coords": {
        "HPOS": 194,
        "VPOS": 506,
        "WIDTH": 1992,
        "HEIGHT": 67
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b3245402",
      "kind": "main",
      "idx": 5,
      "text": "להו, והיה לנו צורך גדול במלאכת ר\"ח ור\"א, ואחר שבירר כ\"ז גאוננו כשמש בחצי השמים, ונפשטו",
      "coords": {
        "HPOS": 194,
        "VPOS": 568,
        "WIDTH": 1994,
        "HEIGHT": 68
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_026ed1ca",
      "kind": "main",
      "idx": 6,
      "text": "כל קמטי הס' הג', הענין הזה עצמו יביאהו אל הגאון להקיץ הנרדמים, וביקש לעוררם על מה",
      "coords": {
        "HPOS": 194,
        "VPOS": 636,
        "WIDTH": 1992,
        "HEIGHT": 66
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_2082343b",
      "kind": "main",
      "idx": 7,
      "text": "שנראה מתוך שאלתם שהניחו שאלתם על התלמוד לבסוף ושאלו עליו כיצד נכתב, וכבר ביארנו לעיל",
      "coords": {
        "HPOS": 216,
        "VPOS": 698,
        "WIDTH": 1972,
        "HEIGHT": 66
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_af0cecf6",
      "kind": "main",
      "idx": 8,
      "text": "\"דספק זה הוא מחולק לד' סעיפיו כמו שהוא מחולק הספק הא' של ,כיצד נכתבה המשנה",
      "coords": {
        "HPOS": 198,
        "VPOS": 771,
        "WIDTH": 1985,
        "HEIGHT": 65
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_0f4ec82f",
      "kind": "main",
      "idx": 9,
      "text": "שביארנו דאם המשנה תורתן של ראשונים מאנשי כנ\"הג למה מזכירין בה סברת האחרונים, וכדומה",
      "coords": {
        "HPOS": 190,
        "VPOS": 834,
        "WIDTH": 1996,
        "HEIGHT": 60
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_5803dfc3",
      "kind": "main",
      "idx": 10,
      "text": "?משאר הסעיפים, כן נמי הוא הספק בתלמוד דאם הוא תורתן של ראשונים למה נזכר בשם אחרונים",
      "coords": {
        "HPOS": 194,
        "VPOS": 894,
        "WIDTH": 1992,
        "HEIGHT": 61
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_4ecc2f33",
      "kind": "main",
      "idx": 11,
      "text": "ואם התלמוד אחרון א\"כ אינו ראשון, ור\"ל א\"כ כל המשא ומתן שבו הוא אחרון בזמן ולא הוה",
      "coords": {
        "HPOS": 192,
        "VPOS": 949,
        "WIDTH": 1998,
        "HEIGHT": 72
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_8a55bdb3",
      "kind": "main",
      "idx": 12,
      "text": "לראשונים מניה מדעם, ע\"ז כגבור יצא הגאון ז\"ל לגרש הטעות הזה מקרב השואל והשלים דבריו",
      "coords": {
        "HPOS": 194,
        "VPOS": 1021,
        "WIDTH": 1992,
        "HEIGHT": 64
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_b3f19ddf",
      "kind": "main",
      "idx": 13,
      "text": "וכתב: \"ו תלמוד נמי דשאלתון עליה\" כלומר ונראה מתוך דבריכם שהוא אחרון בזמן לא",
      "coords": {
        "HPOS": 192,
        "VPOS": 1078,
        "WIDTH": 1996,
        "HEIGHT": 77
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_f107a71e",
      "kind": "main",
      "idx": 14,
      "text": "היא כי אפי' ראשוני ראשונים הוה להו תלמוד אלא שאין גדסתם שוה כי כל אחד מתני לתלמידיה כל",
      "coords": {
        "HPOS": 192,
        "VPOS": 1140,
        "WIDTH": 1994,
        "HEIGHT": 73
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_8423bbb5",
      "kind": "main",
      "idx": 15,
      "text": "הדברים הבאים בתלמוד (הוא הגמרא) באופן משונה מחברו כענין ממש שהיה בעיקרי הדינים",
      "coords": {
        "HPOS": 194,
        "VPOS": 1219,
        "WIDTH": 1992,
        "HEIGHT": 57
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_81824ce7",
      "kind": "main",
      "idx": 16,
      "text": "שבמשנה שכל אחד היה שונה בלשון וסדר משונה מחברו, כן היה הענין ממש בטעמי המשנה",
      "coords": {
        "HPOS": 192,
        "VPOS": 1283,
        "WIDTH": 1998,
        "HEIGHT": 57
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_c274d238",
      "kind": "main",
      "idx": 17,
      "text": "והפלפולים, וההוויות כל אחד היה לו אופן וסדר משונה, אבל כל הנחלים הולכים אל דין אחד וטעם",
      "coords": {
        "HPOS": 194,
        "VPOS": 1336,
        "WIDTH": 1998,
        "HEIGHT": 73
      },
      "para_start": false,
      "is_catchword": false
    },
    {
      "line_id": "eSc_line_fe2b2a3e",
      "kind": "main",
      "idx": 18,
      "text": "אחד, והאריך בראיות מופתיות וז\"א: \"ותלמוד נמי דשאלתון עליה, אפי' ראשוני",
      "coords": {
        "HPOS": 196,
        "VPOS": 1400,
        "WIDTH": 1994,
        "HEIGHT": 64
